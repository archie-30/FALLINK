# Copy this file to "keystore.properties" (same folder) and fill in your own values.
# keystore.properties and *.jks are git-ignored: NEVER commit them or share the passwords.
# storeFile is relative to the android/ folder (an absolute path also works).
storeFile=keystore/inkrage-upload.jks
storePassword=CHANGE_ME
keyAlias=inkrage-upload
keyPassword=CHANGE_ME
